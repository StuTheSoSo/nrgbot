{
  "name": "nrgbot",
  "displayName": "NRGBot",
  "description": "Private NRG Code Wizard",
  "version": "0.0.1",
  "publisher": "Parraid",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ollama-sidebar-container",
          "title": "ParraidBot",
          "icon": "images/robot.svg"
        }
      ]
    },
    "views": {
      "ollama-sidebar-container": [
        {
          "type": "webview",
          "id": "ollama.chatSidebarView",
          "name": "NRG Wizard",
          "icon": "$(comment-discussion)",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "nrgbot.refreshProjectContext",
        "title": "Refresh Project Context",
        "category": "NRGBot"
      },
      {
        "command": "nrgbot.generateKnowledgeDoc",
        "title": "Generate Knowledge Doc",
        "category": "NRGBot"
      },
      {
        "command": "nrgbot.generateRefactorRules",
        "title": "Generate Refactoring Rules",
        "category": "NRGBot"
      },
      {
        "command": "nrgbot.applyProposedEdit",
        "title": "Apply Change",
        "category": "NRGBot",
        "icon": "$(check)"
      },
      {
        "command": "nrgbot.discardProposedEdit",
        "title": "Discard Change",
        "category": "NRGBot",
        "icon": "$(close)"
      },
      {
        "command": "nrgbot.askAboutSelection",
        "title": "Ask about Selection",
        "category": "NRGBot"
      },
      {
        "command": "nrgbot.attachSelection",
        "title": "Add Selection to Chat",
        "category": "NRGBot"
      },
      {
        "command": "nrgbot.attachFile",
        "title": "Add File to Chat",
        "category": "NRGBot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "nrgbot.editorSubmenu",
          "group": "1_modification"
        }
      ],
      "nrgbot.editorSubmenu": [
        {
          "command": "nrgbot.askAboutSelection",
          "when": "editorHasSelection",
          "group": "1_ask@1"
        },
        {
          "command": "nrgbot.attachSelection",
          "when": "editorHasSelection",
          "group": "1_ask@2"
        },
        {
          "command": "nrgbot.attachFile",
          "group": "2_attach@1"
        }
      ],
      "editor/title": [
        {
          "command": "nrgbot.applyProposedEdit",
          "when": "nrgbot.hasPendingEdit",
          "group": "navigation@1"
        },
        {
          "command": "nrgbot.discardProposedEdit",
          "when": "nrgbot.hasPendingEdit",
          "group": "navigation@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "nrgbot.editorSubmenu",
        "label": "NRGBot"
      }
    ],
    "configuration": {
      "title": "NRGBot Configuration",
      "properties": {
        "nrgbot.serverUrl": {
          "type": "string",
          "default": "http://192.168.3.142:11434",
          "description": "The base URL of your remote Ollama server."
        },
        "nrgbot.modelName": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "The exact model name as it appears when running 'ollama list' on your remote machine. A 14b+ tool-calling model is strongly recommended; 7b models often hallucinate tool results."
        },
        "nrgbot.enableTools": {
          "type": "boolean",
          "default": true,
          "description": "Allow the model to call read-only workspace tools (read file, list directory, search text). Requires a tool-calling-capable model."
        },
        "nrgbot.knowledgeFile": {
          "type": "string",
          "default": ".nrgbot/knowledge.md",
          "description": "Workspace-relative path to a hand-authored knowledge doc about this solution. Its contents are injected into the model's system prompt when present."
        },
        "nrgbot.refactorRulesFile": {
          "type": "string",
          "default": ".nrgbot/refactor-rules.md",
          "description": "Workspace-relative path to a hand-authored rules doc. Its contents are appended to the model's prompt on every attached-file coding request so refactors follow your rules."
        },
        "nrgbot.includeProjectMap": {
          "type": "boolean",
          "default": true,
          "description": "Automatically inject a compact map of solution projects, languages, targets, dependencies, packages, and probable entry points."
        },
        "nrgbot.projectContextMaxChars": {
          "type": "number",
          "default": 9000,
          "minimum": 0,
          "description": "Maximum combined characters of injected knowledge, solution map, and applicable refactoring rules. Set to 0 to disable project context."
        },
        "nrgbot.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature sent to the model. Low values (0.1–0.3) keep answers factual and grounded in the knowledge doc; higher values are more creative but hallucinate more."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
